region = "us-east-1"
name = "hadoop"
environment = "dev"
notification_email = "operator@example.com"
monthly_budget = 100
cluster_profiles = {
  analytics = {
    cluster_id = "j-EXAMPLE123"
    allowed_principals = ["arn:aws:iam::123456789012:role/HadoopConsumer"]
    jar_prefixes = ["s3://your-job-assets/approved-jars/"]
    input_prefixes = ["s3://your-data/input/"]
    output_prefixes = ["s3://your-data/output/"]
    log_uri = "s3://your-emr-logs/clusters/"
  }
}
